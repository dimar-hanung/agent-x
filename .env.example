# AgentX — copy to .env.local and fill in values
# cp .env.example .env.local

# Required
OPENROUTER_API_KEY=
# Bootstrap fallback only — runtime model is set in Dashboard → Pengaturan Model (admin)
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
DATABASE_URL=postgresql://agentx:PASSWORD@127.0.0.1:5432/agentx
SESSION_SECRET=

# Integrations (encrypt Gmail app passwords / OAuth tokens at rest)
# Generate: openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=

# Google OAuth (Calendar, Gmail, Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agent.serverlab.my.id/api/integrations/google/callback

# Microsoft OAuth (Outlook, Calendar, OneDrive)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://agent.serverlab.my.id/api/integrations/microsoft/callback

# Optional — Exa web search tools
EXA_API_KEY=

# Optional — Apify social media snapshot tools
APIFY_API_TOKEN=
# APIFY_API_BASE=https://api.apify.com/v2
# APIFY_WORKER_POLL_INTERVAL_MS=15000

# WhatsApp (Evolution API)
WHATSAPP_PROVIDER=unofficial
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=agentx-channel
WHATSAPP_WEBHOOK_SECRET=
AGENTX_PUBLIC_URL=https://agent.serverlab.my.id
AGENTX_WEBHOOK_URL=http://127.0.0.1:3000/api/integrations/whatsapp/webhook
# Personal WhatsApp inbox backfill caps (optional)
# WHATSAPP_BACKFILL_DAYS=7
# WHATSAPP_BACKFILL_MAX_MESSAGES=200
# WHATSAPP_BACKFILL_MAX_CHATS=50

# Scheduler worker
SCHEDULER_POLL_INTERVAL_MS=15000

# SeaweedFS (private per-user file storage — see docs/seaweedfs-setup.md)
SEAWEEDFS_S3_ENDPOINT=http://127.0.0.1:8333
SEAWEEDFS_S3_ACCESS_KEY=agentx_s3_access
SEAWEEDFS_S3_SECRET_KEY=agentx_s3_secret_change_me
SEAWEEDFS_S3_BUCKET=agentx-files
SEAWEEDFS_S3_REGION=us-east-1

# Dev seed override (never set in production unless intentional)
# ALLOW_DB_SEED=1
